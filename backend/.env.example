# Neon Postgres connection string. Get the real value from the Neon project
# dashboard (Connection Details, direct/non-pooler host), then copy this file
# to .env and paste it in there. Never commit the real value.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Django secret key. Generate a real one for local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never commit the real value or reuse this placeholder outside local dev.
SECRET_KEY="replace-with-a-real-generated-secret-key"

DEBUG=True

# Optional. Only needed for the "Generate Estimate" (AI Takeoff -> Estimate)
# feature — POST /api/drawings/<id>/estimate/ returns 503 without it.
# Get a key from https://aistudio.google.com/apikey. Never commit the real
# value; OCR-only usage of this app doesn't need it at all.
# GEMINI_API_KEY="replace-with-a-real-gemini-api-key"
