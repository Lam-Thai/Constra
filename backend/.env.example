# Neon Postgres connection string. Get the real value from the Neon project
# dashboard (Connection Details, direct/non-pooler host), then copy this file
# to .env and paste it in there. Never commit the real value.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Django secret key. Generate a real one for local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never commit the real value or reuse this placeholder outside local dev.
SECRET_KEY="replace-with-a-real-generated-secret-key"

DEBUG=True

# Optional. Only needed for the "Generate Estimate" (AI Takeoff -> Estimate)
# feature — POST /api/drawings/<id>/estimate/ returns 503 without it.
# Get a key from https://aistudio.google.com/apikey. Never commit the real
# value; OCR-only usage of this app doesn't need it at all.
# GEMINI_API_KEY="replace-with-a-real-gemini-api-key"

# --- Deploy-only settings (leave unset for local dev) ---

# Comma-separated list of extra allowed hosts, additive on top of the
# hardcoded localhost/127.0.0.1. Render's own "<app>.onrender.com" hostname
# is picked up automatically from Render's auto-injected
# RENDER_EXTERNAL_HOSTNAME var, so you don't need to list it here too —
# this is only for a custom domain on top of that.
# ALLOWED_HOSTS="api.example.com"

# Comma-separated list of extra CORS origins, additive on top of the
# hardcoded localhost:3000/127.0.0.1:3000 (the Next.js dev server). Add the
# real Vercel deployment URL here once known. Never wildcarded.
# CORS_ALLOWED_ORIGINS="https://constra.vercel.app"

# Absolute URL this server is reachable at, used to build absolute
# Page.image_url values when S3 media storage (below) is NOT configured.
# Defaults to http://localhost:8000 for local dev. Irrelevant once
# AWS_* / S3-compatible storage is configured — S3Storage already returns
# absolute URLs on its own.
# BACKEND_BASE_URL="https://constra-backend.onrender.com"

# --- Optional S3-compatible media storage (Cloudflare R2 recommended, or
# real AWS S3 — anything S3-compatible). All three of ACCESS_KEY_ID /
# SECRET_ACCESS_KEY / STORAGE_BUCKET_NAME must be set together to switch
# storage on; leaving any subset unset keeps local disk storage exactly as
# today (needed on Render — its filesystem is ephemeral across deploys, so
# page PNGs written to local disk there would NOT survive a redeploy). ---
# AWS_ACCESS_KEY_ID="replace-with-a-real-r2-or-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="replace-with-a-real-r2-or-aws-secret-access-key"
# AWS_STORAGE_BUCKET_NAME="constra-media"
# Only set for a non-AWS S3-compatible endpoint, e.g. Cloudflare R2's
# "https://<account_id>.r2.cloudflarestorage.com". Leave unset for real AWS S3.
# AWS_S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
# "auto" works for R2; use a real AWS region (e.g. "us-east-1") for AWS S3.
# AWS_S3_REGION_NAME="auto"
