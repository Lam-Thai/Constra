# Base URL of the Django backend API (see backend/), not a Next.js API route.
# Local dev: http://localhost:8000 (default below).
# Production (Vercel): set this to the deployed Render backend's URL, e.g.
# https://constra-backend.onrender.com — no trailing slash. Configure it as
# an environment variable in the Vercel project settings, not by editing
# this file (which is only a template — .env.local is gitignored).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
